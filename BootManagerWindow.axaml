<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NoStick"
        x:Class="NoStick.BootManagerWindow"
        Title="no-stick Boot Manager"
        Width="1024" Height="768"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a"
        ExtendClientAreaToDecorationsHint="True">
    
    <Grid RowDefinitions="*,Auto,Auto,*" Margin="60">
        
        <!-- TOP SPACER -->
        <Border Grid.Row="0"/>
        
        <!-- HEADER -->
        <StackPanel Grid.Row="1" 
                   HorizontalAlignment="Center"
                   Spacing="16"
                   Margin="0,0,0,40">
            <TextBlock Text="💿"
                      FontSize="64"
                      HorizontalAlignment="Center"/>
            <TextBlock Text="no-stick Boot Manager"
                      FontSize="42"
                      FontWeight="Bold"
                      Foreground="White"
                      HorizontalAlignment="Center"/>
            <TextBlock Name="CountdownText"
                      Text="Booting in 5 seconds..."
                      FontSize="20"
                      Foreground="#888"
                      HorizontalAlignment="Center"
                      Margin="0,8,0,0"/>
        </StackPanel>
        
        <!-- ISO LIST -->
        <Border Grid.Row="2"
               Background="#2a2a2a"
               CornerRadius="16"
               BorderBrush="#444"
               BorderThickness="2"
               Padding="32"
               MaxWidth="800">
            <StackPanel Spacing="20">
                <TextBlock Text="Select Boot ISO:"
                          FontSize="24"
                          FontWeight="SemiBold"
                          Foreground="White"
                          Margin="0,0,0,10"/>
                
                <!-- ISO Items -->
                <ItemsControl Name="ISOList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ISOEntry">
                            <Border Background="#333"
                                   CornerRadius="12"
                                   Padding="20,16"
                                   Margin="0,0,0,12"
                                   Cursor="Hand">
                                <Border.Styles>
                                    <Style Selector="Border:pointerover">
                                        <Setter Property="Background" Value="#444"/>
                                    </Style>
                                </Border.Styles>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Grid.Column="0"
                                             Text="💿"
                                             FontSize="28"
                                             VerticalAlignment="Center"
                                             Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                 FontSize="18"
                                                 FontWeight="SemiBold"
                                                 Foreground="White"/>
                                        <TextBlock Text="{Binding SizeFormatted}"
                                                 FontSize="13"
                                                 Foreground="#999"
                                                 Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                             Name="DefaultBadge"
                                             Text="⭐ DEFAULT"
                                             FontSize="12"
                                             FontWeight="Bold"
                                             Foreground="#fbbf24"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding IsDefault}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- No ISOs Message -->
                <Border Name="NoISOsPanel"
                       Background="#333"
                       CornerRadius="12"
                       Padding="40,30"
                       IsVisible="False">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <TextBlock Text="⚠️"
                                 FontSize="48"
                                 HorizontalAlignment="Center"/>
                        <TextBlock Text="No bootable ISOs found"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 Foreground="White"
                                 HorizontalAlignment="Center"/>
                        <TextBlock Text="System will boot normally"
                                 FontSize="14"
                                 Foreground="#999"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        
        <!-- BOTTOM CONTROLS -->
        <StackPanel Grid.Row="3"
                   Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   Spacing="16"
                   Margin="0,40,0,0">
            <Button Name="BtnBootNow"
                   Content="⚡ Boot Selected Now"
                   Padding="24,14"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Background="#22C55E"
                   Foreground="White"
                   CornerRadius="8"/>
            
            <Button Name="BtnBootNormal"
                   Content="↩️ Boot System Normally"
                   Padding="24,14"
                   FontSize="16"
                   Background="#444"
                   Foreground="White"
                   CornerRadius="8"/>
            
            <Button Name="BtnCancel"
                   Content="❌ Cancel"
                   Padding="24,14"
                   FontSize="16"
                   Background="#555"
                   Foreground="White"
                   CornerRadius="8"/>
        </StackPanel>
        
    </Grid>
</Window>
