# No-Stick: Download a distro. Reads the community catalogue (wallisoft/nostick-distros) and lets you
# pick one to download into your library. If the live catalogue can't be reached, a built-in copy is used.

@Window Download
Title=Download a distro
Width=720
Height=520
OnOpened=DlLoad

@DockPanel DlRoot
Parent=Download

@Border DlHeader
Parent=DlRoot
DockPanel.Dock=Top
Height=50
Background=#1E3A8A
Padding=16,0

@TextBlock DlTitle
Parent=DlHeader
Text=Download a distro
FontSize=18
FontWeight=Bold
Foreground=White
VerticalAlignment=Center

@Border DlFooter
Parent=DlRoot
DockPanel.Dock=Bottom
Height=52
Background=#F3F4F6
BorderBrush=#E5E7EB
BorderThickness=0,1,0,0
Padding=14,0

@StackPanel DlFootRow
Parent=DlFooter
Orientation=Horizontal
Spacing=8
VerticalAlignment=Center

@TextBlock dlInfo
Parent=DlFootRow
Text=Choose a distribution
Foreground=#6B7280
FontSize=12
VerticalAlignment=Center

@Button btnDlCancel
Parent=DlFootRow
Content=Cancel
Padding=16,6
OnClick=CloseSelf

@Button btnDlGet
Parent=DlFootRow
Content=Download
Background=#2563EB
Foreground=White
Padding=22,6
OnClick=DlGet

@StackPanel DlMain
Parent=DlRoot
Margin=16
Spacing=4

@TextBlock DlHint
Parent=DlMain
Text=Distributions from the No-Stick community catalogue. The ISO downloads from the project's own official site.
Foreground=#4B5563
FontSize=12
TextWrapping=Wrap

@ListBox distros
Parent=DlMain
Height=360
FontFamily=monospace
SelectionChanged=DlSelected

@Script DlLoad
Interpreter=lua
<<LUA
-- Try the live community catalogue; fall back to a built-in starter list offline.
CATALOGUE_URL = "https://raw.githubusercontent.com/wallisoft/nostick-distros/main/distros.json"
local json = require("dkjson")
local raw = Vml("Shell", "curl -fsSL --max-time 8 '" .. CATALOGUE_URL .. "' 2>/dev/null")
local cat = raw ~= "" and json.decode(raw) or nil

if not cat then
    -- built-in copy of the catalogue, used when the live one can't be reached (same entries as distros.json
    -- in wallisoft/nostick-distros at the time of this release)
    cat = {distros = {
        {name = "Debian 13", group = "Tested on real hardware", size = "3.5G", live = true, install = true,
         status = "installs and boots",
         url = "https://cdimage.debian.org/debian-cd/current-live/amd64/iso-hybrid/debian-live-13.7.0-amd64-gnome.iso"},
        {name = "Ubuntu 24.04 LTS", group = "Tested on real hardware", size = "6.2G", live = true, install = true,
         status = "boots live; installs like Debian",
         url = "https://releases.ubuntu.com/24.04/ubuntu-24.04.4-desktop-amd64.iso"},
        {name = "Fedora Workstation 41", group = "Tested on real hardware", size = "2.3G", live = true, install = true,
         status = "installs and boots (older release)",
         url = "https://archives.fedoraproject.org/pub/archive/fedora/linux/releases/41/Workstation/x86_64/iso/Fedora-Workstation-Live-x86_64-41-1.4.iso"},
        {name = "Linux Mint 22 Cinnamon", group = "Tested on real hardware", size = "2.7G", live = true, install = true,
         status = "boots; new PCs need a newer kernel",
         url = "https://mirrors.edge.kernel.org/linuxmint/stable/22/linuxmint-22-cinnamon-64bit.iso"},
        {name = "Ubuntu 26.04 LTS", group = "Same recipe - not yet tested", size = "6.1G", live = true, install = true,
         status = "should work - tell us",
         url = "https://releases.ubuntu.com/26.04/ubuntu-26.04-desktop-amd64.iso"},
        {name = "Linux Mint 22.3 Cinnamon", group = "Same recipe - not yet tested", size = "2.9G", live = true, install = true,
         status = "should work - tell us",
         url = "https://mirrors.edge.kernel.org/linuxmint/stable/22.3/linuxmint-22.3-cinnamon-64bit.iso"},
        {name = "Fedora Workstation 44", group = "Same recipe - not yet tested", size = "2.7G", live = true, install = true,
         status = "should work - tell us",
         url = "https://download.fedoraproject.org/pub/fedora/linux/releases/44/Workstation/x86_64/iso/Fedora-Workstation-Live-44-1.7.x86_64.iso"},
        {name = "Arch Linux", group = "Experimental", size = "1.5G", live = true, install = true,
         status = "recipe not booted in its current form",
         url = "https://mirrors.edge.kernel.org/archlinux/iso/latest/archlinux-x86_64.iso"},
    }}
end

DISTROS = cat.distros
local lines, group = {}, nil
-- headings appear in the order the catalogue first mentions them
local order, known = {}, {}
for _, d in ipairs(DISTROS) do
    local g = d.group or "Other"
    if not known[g] then known[g] = true; order[#order + 1] = g end
end
local seen = {}
for _, g in ipairs(order) do
    for _, d in ipairs(DISTROS) do
        if (d.group or "Other") == g then
            if group ~= g then
                lines[#lines + 1] = "-- " .. (g:gsub(",", ";")) .. " --"
                group = g
            end
            d._row = #lines + 1
            local tags = d.status or ((d.live and "live" or "") .. (d.live and d.install and " + " or "") .. (d.install and "install" or ""))
            lines[#lines + 1] = string.format("   %-26s %6s   %s", (d.name:gsub(",", ";")), d.size or "", (tags:gsub(",", ";")))
            seen[d] = true
        end
    end
end
Vml("SetProperty", "distros", "Items", table.concat(lines, ","))
Vml("SetProperty", "btnDlGet", "IsEnabled", "false")
Vml("SetStatusText", #DISTROS .. " distributions")
LUA

@Script DlSelected
Interpreter=lua
<<LUA
local i = (tonumber(Vml("GetProperty", "distros", "SelectedIndex")) or -1) + 1
-- map the selected visible row back to a distro (skip the group headers)
local chosen = nil
for _, d in ipairs(DISTROS or {}) do if d._row == i then chosen = d end end
SELECTED = chosen
if chosen then
    Vml("SetProperty", "dlInfo", "Text", chosen.name .. "  ->  " .. (chosen.url or ""))
    Vml("SetProperty", "btnDlGet", "IsEnabled", "true")
else
    Vml("SetProperty", "dlInfo", "Text", "Choose a distribution")
    Vml("SetProperty", "btnDlGet", "IsEnabled", "false")
end
LUA

@Script DlGet
Interpreter=lua
<<LUA
if not SELECTED then return end
if not SELECTED.url or not SELECTED.url:match("%.iso$") then
    -- catalogue entry points at a download PAGE, not a direct .iso (Fedora, Bazzite, etc.)
    Vml("InfoDialog", SELECTED.name .. " is downloaded from its own site:\n\n" .. (SELECTED.url or "") ..
        "\n\nSave the .iso, then use 'Add an ISO I have'.", SELECTED.name)
    return
end
-- a direct .iso link: hand it back to the main window to fetch with progress
local file = SELECTED.url:match("([^/]+)$")
Vml("SetSetting", "nostick_dl_url", SELECTED.url)
Vml("SetSetting", "nostick_dl_name", file)
Vml("CloseSelf")
LUA
