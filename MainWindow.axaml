<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NoStick"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="NoStick.MainWindow"
        Title="no-stick - Bootable ISO Manager"
        Width="800" Height="750"
        CanResize="true"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SystemChromeLowColor}">
    
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">
        
        <!-- HEADER CARD -->
        <Border Grid.Row="0" 
                Background="{DynamicResource SystemAccentColor}"
                CornerRadius="12"
                Padding="20,16"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                          Text="💿"
                          FontSize="32"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="no-stick"
                              FontSize="22"
                              FontWeight="Bold"
                              Foreground="White"/>
                    <TextBlock Text="Bootable ISO Manager"
                              FontSize="13"
                              Foreground="White"
                              Opacity="0.9"
                              Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Name="SwapInfoText"
                              Text="Swap: Detecting..."
                              FontSize="11"
                              Foreground="White"
                              Opacity="0.95"
                              HorizontalAlignment="Right"
                              FontWeight="SemiBold"/>
                    <TextBlock Name="VersionText"
                              Text="v1.0.0"
                              FontSize="10"
                              Foreground="White"
                              Opacity="0.85"
                              HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- MAIN CONTENT - Two Columns -->
        <Grid Grid.Row="1" ColumnDefinitions="*,16,*" Margin="0,0,0,16">
            
            <!-- LEFT COLUMN - Installed ISOs -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemChromeMediumLowColor}"
                    BorderBrush="{DynamicResource SystemBaseMediumColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                    
                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                              Text="📁 Installed ISOs"
                              FontSize="16"
                              FontWeight="SemiBold"
                              Margin="0,0,0,16"/>
                    
                    <!-- ISO Selector Dropdown -->
                    <ComboBox Grid.Row="1"
                             Name="ISOComboBox"
                             Padding="12,10"
                             FontSize="13"
                             Margin="0,0,0,12"
                             HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ISOEntry">
                                <StackPanel Orientation="Vertical" Margin="4">
                                    <TextBlock Text="{Binding Name}" 
                                              FontWeight="SemiBold"
                                              FontSize="12"/>
                                    <TextBlock Text="{Binding SizeFormatted}" 
                                              FontSize="10"
                                              Foreground="{DynamicResource SystemBaseMediumColor}"
                                              Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Action Buttons (3) -->
                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,16">
                        <Button Name="BtnAddLocalISO"
                                Content="➕ Add Local ISO"
                                Padding="12,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="13"
                                ToolTip.Tip="Browse and add ISO from filesystem"/>
                        
                        <Button Name="BtnCopyToSwap"
                                Content="💾 Copy to Swap"
                                Padding="12,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="13"
                                IsEnabled="False"
                                ToolTip.Tip="Copy selected ISO to swap partition"/>
                        
                        <Button Name="BtnRemove"
                                Content="🗑️ Remove ISO"
                                Padding="12,10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                FontSize="13"
                                IsEnabled="False"
                                ToolTip.Tip="Remove selected ISO"/>
                    </StackPanel>
                    
                    <!-- Boot Default Checkbox -->
                    <Border Grid.Row="3"
                           Background="{DynamicResource SystemChromeMediumColor}"
                           CornerRadius="8"
                           Padding="12"
                           Margin="0,0,0,12">
                        <CheckBox Name="ChkSetAsDefault"
                                 Content="Set as default boot"
                                 IsEnabled="False"
                                 FontSize="12"/>
                    </Border>
                    
                    <!-- Spacer -->
                    <Border Grid.Row="4"/>
                    
                    <!-- ISO Count -->
                    <Border Grid.Row="5"
                           Background="{DynamicResource SystemAccentColorLight3}"
                           CornerRadius="6"
                           Padding="10,8">
                        <TextBlock Name="ISOCountText"
                                  Text="No ISOs installed"
                                  FontSize="11"
                                  HorizontalAlignment="Center"
                                  FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
            
            <!-- RIGHT COLUMN - Download Distributions -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SystemChromeMediumLowColor}"
                    BorderBrush="{DynamicResource SystemBaseMediumColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                    
                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                              Text="⬇️ Download Distributions"
                              FontSize="16"
                              FontWeight="SemiBold"
                              Margin="0,0,0,16"/>
                    
                    <!-- Search Box -->
                    <TextBox Grid.Row="1"
                            Name="SearchBox"
                            Watermark="🔍 Search distributions..."
                            Padding="12,10"
                            FontSize="13"
                            Margin="0,0,0,12"/>
                    
                    <!-- Distribution Dropdown -->
                    <ComboBox Grid.Row="2"
                             Name="DistroComboBox"
                             Padding="12,10"
                             FontSize="13"
                             Margin="0,0,0,12"
                             HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:DistroEntry">
                                <Grid ColumnDefinitions="Auto,*" Margin="4">
                                    <TextBlock Grid.Column="0"
                                              Text="{Binding Icon}"
                                              FontSize="20"
                                              VerticalAlignment="Center"
                                              Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                  FontWeight="SemiBold"
                                                  FontSize="12"/>
                                        <TextBlock Text="{Binding Description}"
                                                  FontSize="10"
                                                  Foreground="{DynamicResource SystemBaseMediumColor}"
                                                  Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    
                    <!-- Download Button (Greyed Initially) -->
                    <Button Grid.Row="3"
                            Name="BtnDownload"
                            Content="⬇️ Download Selected ISO"
                            IsEnabled="False"
                            Padding="12,10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8"
                            Background="{DynamicResource SystemAccentColor}"
                            Foreground="White"
                            ToolTip.Tip="Select a distribution to download"/>
                    
                    <!-- Safe Boot ISO Now Button with Browse -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <Button Grid.Column="0"
                               Name="BtnSafeBootNow"
                               Content="🚀 Safe Boot ISO Now"
                               Padding="12,10"
                               HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"
                               Background="#22C55E"
                               Foreground="White"
                               ToolTip.Tip="Boot the selected ISO immediately"/>
                        <Button Grid.Column="1"
                               Name="BtnBrowseForBoot"
                               Content="📁"
                               Padding="12,10"
                               FontSize="14"
                               ToolTip.Tip="Browse filesystem for ISO"/>
                    </Grid>
                    
                    <!-- Spacer -->
                    <Border Grid.Row="5"/>
                    
                    <!-- Selected Info & Progress -->
                    <StackPanel Grid.Row="6" Spacing="8">
                        <Border Background="{DynamicResource SystemChromeMediumColor}"
                               CornerRadius="6"
                               Padding="10,8">
                            <TextBlock Name="SelectedDistroText"
                                      Text="Select a distribution to download"
                                      FontSize="11"
                                      TextWrapping="Wrap"
                                      Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        </Border>
                        
                        <ProgressBar Name="DownloadProgress"
                                    Height="6"
                                    IsIndeterminate="False"
                                    IsVisible="False"
                                    CornerRadius="3"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- BOTTOM PANEL - Settings -->
        <Border Grid.Row="2"
                Background="{DynamicResource SystemChromeMediumLowColor}"
                BorderBrush="{DynamicResource SystemBaseMediumColor}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,16"
                Margin="0,0,0,16">
            <Grid ColumnDefinitions="*,32,*">
                
                <!-- Left Side - Boot Options -->
                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock Text="🚀 Boot Options"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Margin="0,0,0,4"/>
                    <CheckBox Name="ChkQuietBoot"
                             Content="Quiet boot (no menu shown)"
                             IsChecked="True"
                             FontSize="12"/>
                    <CheckBox Name="ChkEscInterrupt"
                             Content="ESC interrupt (1000ms pause)"
                             IsChecked="True"
                             FontSize="12"/>
                </StackPanel>
                
                <!-- Right Side - Configuration -->
                <StackPanel Grid.Column="2" Spacing="12">
                    <TextBlock Text="⚙️ Configuration"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Margin="0,0,0,4"/>
                    
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                  Text="Target:"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1"
                                 Name="TargetComboBox"
                                 SelectedIndex="0"
                                 HorizontalAlignment="Stretch"
                                 Padding="10,8"
                                 FontSize="12">
                            <ComboBoxItem Content="Existing swap partition"/>
                            <ComboBoxItem Content="New filesystem (64GB)"/>
                            <ComboBoxItem Content="New filesystem (32GB)"/>
                            <ComboBoxItem Content="New filesystem (8GB)"/>
                        </ComboBox>
                    </Grid>
                    
                    <UniformGrid Rows="1" Columns="3">
                        <Button Name="BtnDetectPartitions"
                                Content="🔍 Detect"
                                Padding="10,8"
                                Margin="0,0,4,0"
                                HorizontalContentAlignment="Center"
                                FontSize="12"
                                ToolTip.Tip="Detect swap partitions"/>
                        <Button Name="BtnGrubConfig"
                                Content="⚙️ GRUB2"
                                Padding="10,8"
                                Margin="2,0"
                                HorizontalContentAlignment="Center"
                                FontSize="12"
                                ToolTip.Tip="Configure GRUB2 bootloader"/>
                        <Button Name="BtnRefresh"
                                Content="🔄 Refresh"
                                Padding="10,8"
                                Margin="4,0,0,0"
                                HorizontalContentAlignment="Center"
                                FontSize="12"
                                ToolTip.Tip="Refresh all lists"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- FOOTER SECTION -->
        <StackPanel Grid.Row="3" Spacing="8">
            <!-- Website Banner -->
            <Border Background="{DynamicResource SystemAccentColorLight3}"
                   CornerRadius="8"
                   Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" 
                               Orientation="Horizontal" 
                               Spacing="6"
                               VerticalAlignment="Center">
                        <TextBlock Text="💡" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <Run Text="Visit"/>
                            <Run Text="no-stick.uk" FontWeight="Bold"/>
                            <Run Text="for updates and documentation"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Name="MenuVisitWebsite"
                               Content="🌐 Website"
                               Padding="12,6"
                               FontSize="11"/>
                        <Button Name="MenuAbout"
                               Content="ℹ️ About"
                               Padding="12,6"
                               FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Status Bar -->
            <Border Background="{DynamicResource SystemChromeMediumColor}"
                   BorderBrush="{DynamicResource SystemBaseMediumColor}"
                   BorderThickness="1"
                   CornerRadius="8"
                   Padding="12,8">
                <TextBlock Name="StatusText"
                          Text="Ready"
                          FontSize="11"
                          VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
        
    </Grid>
</Window>
